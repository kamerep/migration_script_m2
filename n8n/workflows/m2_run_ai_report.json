    }
   },
   "id": "9b5500a0-090f-54c9-bb4a-6f2f5475a902",
   "name": "Final summary",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    2400,
    400
   ]
  },
  {
   "parameters": {
    "jsCode": "// Markdown report of the run: totals, AI status and actions, what to decide.\nconst s = $('Final summary').first().json;\nconst ai = s.ai_summary || {};\nconst t = s.totals || {}, lv = s.levels || {};\nconst icon = {green: '🟢', amber: '🟠', red: '🔴'}[ai.status] || '⚪';\nconst lines = [\n  `# M2 migration run ${s.run}`, '',\n  `${icon} **${ai.headline || (t.import + ' rows to import, ' + t.review + ' to review')}**`, '',\n  `| Rows to import | To review | Errors | Warnings | AI suggestions | Clients missing KYC docs |`,\n  `|---:|---:|---:|---:|---:|---:|`,\n  `| ${t.import ?? 0} | ${t.review ?? 0} | ${lv.error ?? 0} | ${lv.warning ?? 0} | ${s.ai_suggestions ?? 0} | ${s.document_gaps ?? 0} |`, '',\n];\nif ((ai.actions || []).length) { lines.push('## Next actions', ''); ai.actions.forEach((a, i) => lines.push(`${i + 1}. ${a}`)); lines.push(''); }\nif (ai.notes) lines.push(ai.notes, '');\nlines.push(`Source: \\`${s.source}\\` · open the run in the UI: ${$('Settings').first().json.ui}/ (Earlier runs → ${s.run})`);\nconst text = lines.join('\\n');\nconst binary = { data: await this.helpers.prepareBinaryData(Buffer.from(text, 'utf8'), 'n8n_report.md', 'text/markdown') };\nreturn [{ json: { run: s.run, status: ai.status || (lv.error ? 'red' : t.review ? 'amber' : 'green'), headline: ai.headline, report: text, totals: t }, binary }];"
   },
   "id": "7f96298d-3632-53e5-9150-76794fa9f7d4",
   "name": "Format report",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2640,
    400
   ]
  },
  {
   "parameters": {
    "operation": "write",
    "fileName": "={{ $('Settings').first().json.report_dir }}/{{ $json.run }}/n8n_report.md",
    "options": {}
   },
   "id": "4bf7f549-52b5-54ab-a31e-a32330404152",
   "name": "Save report",
   "type": "n8n-nodes-base.readWriteFile",
   "typeVersion": 1,
   "position": [
    2880,
    300
   ]
  },
  {
   "parameters": {
    "respondWith": "json",
    "responseBody": "={{ JSON.stringify({ run: $json.run, status: $json.status, headline: $json.headline, totals: $json.totals }) }}",
    "options": {}
   },
   "id": "e8502068-fe2f-5482-b70d-96b353a32d95",
   "name": "Answer webhook",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.1,
   "position": [
    2880,
    500
   ]
  },
  {
   "parameters": {
    "width": 620,
    "height": 220,
    "content": "## M2 migration: run + local AI report\nStarts a run of the M2 → CSP migration on the export folder last used in the UI (or `source` in the webhook body), waits for it, lets the local model (Ollama) suggest decisions, type the documents and write a summary, then saves `runs/<run>/n8n_report.md`.\n\nNothing is written to Odoo. Attach a mail / chat node after **Format report** to send the report (the text is in `report`)."
   },
   "id": "6aae5aff-242b-5359-b22f-dbb8a1e2dcfd",
   "name": "Note",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    240,
    -260
   ]
  }
 ],
