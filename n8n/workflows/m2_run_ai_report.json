   ],
   "webhookId": "m2-run"
  },
  {
   "parameters": {
    "jsCode": "// Where the migration UI listens and its API token (bin/m2ctl.sh token). n8n reads them from its environment\n// (see n8n/m2-n8n.sh); a webhook call may name another export folder in its body: {\"source\": \"/path\"}.\nconst body = $json.body || {};\nreturn [{ json: {\n  ui: $env.M2_UI_URL || 'http://127.0.0.1:8796',\n  token: $env.M2_API_TOKEN,\n  source: body.source || $env.M2_SOURCE || '',\n  ai_tasks: body.ai_tasks || ['suggest', 'documents', 'summary'],\n  report_dir: $env.M2_REPORT_DIR || '/data/migration_script/runs',\n}}];"
   },
   "id": "f8bbc1e7-6ddc-5d09-bdad-94f9d7949755",
   "name": "Settings",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    240,
    200
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $('Settings').first().json.ui }}/api/run",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "X-Token",
       "value": "={{ $('Settings').first().json.token }}"
      }
     ]
    },
    "options": {
     "timeout": 60000
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ source: $json.source, last_source: true }) }}"
   },
   "id": "e252f79e-0dca-5cb2-8940-355c83456cf0",
   "name": "Start run",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    480,
    200
   ]
  },
  {
   "parameters": {
    "amount": 3
   },
   "id": "ae05a9b6-17c3-5526-9b77-ea9d6dc04b0e",
   "name": "Wait for run",
   "type": "n8n-nodes-base.wait",
   "typeVersion": 1.1,
   "position": [
    720,
    200
   ],
   "webhookId": "2f299256-971e-5b90-8a4d-ec68aa2e8cda"
  },
  {
   "parameters": {
    "method": "GET",
    "url": "={{ $('Settings').first().json.ui }}/api/summary",
    "sendHeaders": true,
    "headerParameters": {
