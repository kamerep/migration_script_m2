   "typeVersion": 4.2,
   "position": [
    960,
    200
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "c43e9ec5-d46a-5d4c-9333-ec18de963036",
       "leftValue": "={{ $json.state }}",
       "rightValue": "running",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "90d8901f-3168-593f-ba14-9a3e921ec0b2",
   "name": "Still running?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1200,
    200
