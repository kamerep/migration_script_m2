    1920,
    300
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "dc170698-3020-5158-bd70-31862053eb98",
       "leftValue": "={{ $json.job.state }}",
       "rightValue": "running",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
