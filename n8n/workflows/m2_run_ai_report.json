  },
  {
   "parameters": {
    "amount": 5
   },
   "id": "f5cc9f8c-fea3-50c3-886f-901ef918ff74",
   "name": "Wait for AI",
   "type": "n8n-nodes-base.wait",
   "typeVersion": 1.1,
   "position": [
