       "value": "={{ $('Settings').first().json.token }}"
      }
     ]
    },
    "options": {
     "timeout": 60000
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ run: $('Start run').first().json.run, tasks: $('Settings').first().json.ai_tasks }) }}"
   },
   "id": "abdda38f-b017-54b5-adbe-3cd23c765357",
   "name": "Ask the local AI",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
